# Copie ce fichier en variables d'environnement Vercel (Project Settings >
# Environment Variables). Ne jamais committer de vraies valeurs.

# --- Gemini (génération d'articles) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Sécurise l'endpoint de déclenchement manuel (Authorization: Bearer <valeur>) ---
PUBLISH_SECRET=

# --- Discord (notification + validation) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=

# --- GitHub App dédiée (commit des articles générés) ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Coller la clé privée .pem telle quelle ; Vercel gère les vrais retours à la
# ligne. Si tu la mets dans un fichier .env local, remplace les retours à la
# ligne par \n littéral sur une seule ligne.
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_OWNER=KeumssNova
GITHUB_REPO_NAME=Nova-Corporation-Website
# IMPORTANT : doit être la branche que Vercel déploie en production (à
# vérifier dans Vercel > Settings > Git), pas forcément "main".
GITHUB_REPO_BRANCH=

# --- Lien inclus dans le message Discord une fois publié ---
SITE_URL=https://nova-corporation.vercel.app
