# Copie ce fichier en variables d'environnement Vercel (Project Settings >
# Environment Variables). Ne jamais committer de vraies valeurs.

# --- Gemini (génération d'articles) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Sécurise l'endpoint de déclenchement manuel (Authorization: Bearer <valeur>) ---
PUBLISH_SECRET=

# --- Veille quotidienne (voir vercel.json pour l'horaire) ---
# Vercel l'injecte automatiquement en Authorization: Bearer sur les appels
# Cron declenches par vercel.json -- suffit de definir une valeur ici,
# aucune config manuelle supplementaire cote Vercel.
CRON_SECRET=

# --- Discord (notification + validation + commande /article) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=
# Application ID (Developer Portal > General Information). Necessaire pour
# editer la reponse differee de la commande /article.
DISCORD_APPLICATION_ID=
# Uniquement pour l'enregistrement ponctuel de la commande (voir
# scripts/register-discord-command.js) -- pas utilisee par le runtime Vercel,
# pas la peine de l'ajouter aux env vars du projet.
# DISCORD_GUILD_ID=

# --- GitHub App dédiée (commit des articles générés) ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Coller la clé privée .pem telle quelle ; Vercel gère les vrais retours à la
# ligne. Si tu la mets dans un fichier .env local, remplace les retours à la
# ligne par \n littéral sur une seule ligne.
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_OWNER=KeumssNova
GITHUB_REPO_NAME=Nova-Corporation-Website
# IMPORTANT : doit être la branche que Vercel déploie en production (à
# vérifier dans Vercel > Settings > Git), pas forcément "main".
GITHUB_REPO_BRANCH=

# --- Lien inclus dans le message Discord une fois publié ---
SITE_URL=https://nova-corporation.vercel.app
